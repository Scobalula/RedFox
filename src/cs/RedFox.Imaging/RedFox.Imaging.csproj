<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageDescription>Image representation, pixel codecs, block compression, and processing for RedFox.</PackageDescription>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>RedFox.Imaging</AssemblyName>
    <RootNamespace>RedFox.Imaging</RootNamespace>
    <PackageId>RedFox.Imaging</PackageId>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>

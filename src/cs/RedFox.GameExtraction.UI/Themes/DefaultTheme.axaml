<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:search="using:AvaloniaEdit.Search">

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Border.app-toolbar">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRaisedBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeToolbarBrush}"/>
    </Style>

    <Style Selector=":is(Window).custom-chrome">
        <Setter Property="ExtendClientAreaToDecorationsHint" Value="True"/>
        <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="0"/>
        <Setter Property="WindowDecorationsTheme" Value="{DynamicResource TitleBarDecorationsTheme}"/>
    </Style>

    <Style Selector=":is(UserControl).window-titlebar">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}"/>
    </Style>

    <Style Selector="Image.titlebar-icon">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="PathIcon.titlebar-glyph">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector=".window-titlebar.inactive PathIcon.titlebar-glyph">
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
    </Style>

    <Style Selector="PathIcon.empty-icon">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
    </Style>

    <Style Selector=".window-titlebar.inactive TextBlock.sidebar-title">
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
    </Style>

    <Style Selector="Button.caption-btn">
        <Setter Property="Width" Value="46"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style Selector="Button.caption-btn, :is(Button).icon-btn, Button.toolbar-icon-btn">
        <Setter Property="AutomationProperties.Name" Value="{Binding $self.(ToolTip.Tip)}"/>
    </Style>

    <Style Selector="PathIcon, Image.titlebar-icon">
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw"/>
    </Style>

    <Style Selector=".window-titlebar.inactive Button.caption-btn">
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
    </Style>

    <Style Selector="Button.caption-btn Path">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
    </Style>

    <Style Selector="Button.caption-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="Button.caption-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}"/>
    </Style>

    <Style Selector="Button.caption-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="Button.caption-btn.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#C42B1C"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Button.caption-btn.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#A32417"/>
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRaisedBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
        <Setter Property="BoxShadow" Value="0 1 2 0 #66000000, 0 0 10 0 #66000000"/>
    </Style>

    <Style Selector="Border.panel-shadow">
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
        <Setter Property="BoxShadow" Value="0 1 2 0 #66000000, 0 0 10 0 #66000000"/>
    </Style>

    <Style Selector="Border.asset-list-panel">
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.panel-shadow">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRaisedBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
    </Style>

    <Style Selector="Border.panel-shadow > Border.panel">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="BoxShadow" Value="none"/>
    </Style>

    <Style Selector="Border.status-bar">
        <Setter Property="Padding" Value="12,7"/>
    </Style>

    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.pill > TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
    </Style>

    <Style Selector="Border.preview-toolbar">
        <Setter Property="Background" Value="{DynamicResource ThemePanelHeaderBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style Selector="Border.preview-toolbar.bottom">
        <Setter Property="Background" Value="{DynamicResource ThemeHeaderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <Style Selector="Border.preview-overlay">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style Selector="TextBlock.title, TextBlock.sidebar-title">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.status-text, TextBlock.asset-info, TextBlock.preview-stats, StackPanel.preview-field > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.asset-name">
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.asset-info">
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="Border.asset-icon">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.asset-icon PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
    </Style>

    <Style Selector="Border.asset-thumbnail">
        <Setter Property="Padding" Value="4"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}"/>
    </Style>

    <Style Selector="Border.asset-preview-highlight">
        <Setter Property="Background" Value="{DynamicResource AssetPreviewSelectionBrush}"/>
    </Style>

    <Style Selector="Border.asset-preview-badge">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AssetPreviewForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="TextBlock.preview-stats.error">
        <Setter Property="Foreground" Value="{DynamicResource ThemeDestructiveBrush}"/>
    </Style>

    <Style Selector="StackPanel.preview-field">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.sidebar-desc, TextBlock.setting-desc">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="TextBlock.sidebar-section">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
        <Setter Property="Margin" Value="10,10,0,4"/>
    </Style>

    <Style Selector="TextBlock.setting-category">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Separator.sidebar-sep">
        <Setter Property="Margin" Value="0,6"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}"/>
    </Style>

    <Style Selector="Button.sidebar-btn, Button.accent-btn">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.sidebar-btn PathIcon, Button.accent-btn PathIcon">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
    </Style>

    <Style Selector="Border.asset-thumbnail PathIcon">
        <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <Style Selector="Button.sidebar-btn.secondary-action-btn PathIcon, :is(Button).icon-btn PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
    </Style>

    <Style Selector=":is(Button).icon-btn:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="MenuItem PathIcon">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
    </Style>

    <Style Selector="PathIcon.open-icon">
        <Setter Property="Foreground" Value="{DynamicResource IconOpenBrush}"/>
    </Style>

    <Style Selector="PathIcon.export-icon">
        <Setter Property="Foreground" Value="{DynamicResource IconExportBrush}"/>
    </Style>

    <Style Selector="PathIcon.model-icon">
        <Setter Property="Foreground" Value="{DynamicResource IconModelBrush}"/>
    </Style>

    <Style Selector="PathIcon.animation-icon">
        <Setter Property="Foreground" Value="{DynamicResource IconAnimationBrush}"/>
    </Style>

    <Style Selector="PathIcon.image-icon">
        <Setter Property="Foreground" Value="{DynamicResource IconImageBrush}"/>
    </Style>

    <Style Selector="PathIcon.sound-icon">
        <Setter Property="Foreground" Value="{DynamicResource IconSoundBrush}"/>
    </Style>

    <Style Selector="PathIcon.preview-icon">
        <Setter Property="Foreground" Value="{DynamicResource AssetPreviewForegroundBrush}"/>
    </Style>

    <Style Selector="PathIcon.heart-icon">
        <Setter Property="Foreground" Value="{DynamicResource HeartBrush}"/>
    </Style>

    <Style Selector="PathIcon.destructive-icon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeDestructiveBrush}"/>
    </Style>

    <Style Selector="Button.sidebar-btn TextBlock, Button.accent-btn TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.sidebar-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
    </Style>

    <Style Selector="Button.sidebar-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="Button.sidebar-btn.secondary-action-btn">
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="Button.sidebar-btn.secondary-action-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
    </Style>

    <Style Selector="Button.sidebar-btn.secondary-action-btn:disabled">
        <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <Style Selector="Button.sidebar-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}"/>
    </Style>

    <Style Selector="Button.accent-btn">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="Foreground" Value="#FFFBEB"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.accent-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="#FFFBEB"/>
    </Style>

    <Style Selector="Button.accent-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
        <Setter Property="Foreground" Value="#FFFBEB"/>
    </Style>

    <Style Selector="Button.secondary-btn, :is(Button).icon-btn">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRaisedInputBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SecondaryActionBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.secondary-btn">
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="90"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector=":is(Button).icon-btn">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.secondary-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter, :is(Button).icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryActionHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRingBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="Button.secondary-btn:pressed /template/ ContentPresenter#PART_ContentPresenter, :is(Button).icon-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryActionPressedBrush}"/>
    </Style>

    <Style Selector="Button.secondary-btn.compact">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <Style Selector="Button.toolbar-icon-btn">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
    </Style>

    <Style Selector="Button.toolbar-icon-btn PathIcon">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
    </Style>

    <Style Selector="Button.accent-btn.toolbar-icon-btn">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Separator.toolbar-sep">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}"/>
    </Style>

    <Style Selector=":is(Button).icon-btn.active">
        <Setter Property="Background" Value="{DynamicResource AssetSelectionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AssetSelectionBorderBrush}"/>
    </Style>

    <Style Selector=":is(Button).icon-btn.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AssetSelectionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AssetSelectionBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector=":is(Button).icon-btn.active PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="Button.secondary-btn:disabled /template/ ContentPresenter#PART_ContentPresenter, :is(Button).icon-btn:disabled /template/ ContentPresenter#PART_ContentPresenter, search|SearchPanel Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryActionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRaisedInputBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector=":is(Button).icon-btn.active:pointerover /template/ ContentPresenter#PART_ContentPresenter, :is(Button).icon-btn.active:pressed /template/ ContentPresenter#PART_ContentPresenter, :is(Button).icon-btn.active:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AssetSelectionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AssetSelectionBorderBrush}"/>
    </Style>

    <Style Selector=":is(Button).icon-btn.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.accent-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="#FFFBEB"/>
    </Style>

    <Style Selector="Button.sidebar-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
    </Style>

    <Style Selector="Button.filter-select-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="Button:disabled, TextBox:disabled, ComboBox:disabled, Slider:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector=":is(Button) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.08"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector=":is(Button)">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderThickness="1" BorderBrush="{DynamicResource ThemeForegroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"/>
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <Style Selector="MenuFlyoutPresenter, ContextMenu">
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
        <Setter Property="Background" Value="{DynamicResource ThemePopupBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRaisedInputBrush}"/>
    </Style>

    <Style Selector="MenuFlyoutPresenter /template/ Border#LayoutRoot, ContextMenu /template/ Border#LayoutRoot">
        <Setter Property="Padding" Value="{DynamicResource MenuFlyoutPresenterThemePadding}"/>
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="MenuFlyoutPresenter Separator, MenuItem Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}"/>
    </Style>

    <Style Selector="Expander.preview-details">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <Style Selector="Expander.preview-details Grid > TextBlock, Expander.preview-details Grid > SelectableTextBlock">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Expander.preview-details Grid > TextBlock.status-text">
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style Selector="Expander.preview-details /template/ ToggleButton#ExpanderHeader">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="TextBox.search-box">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox.search-box.compact-input">
        <Setter Property="Width" Value="200"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style Selector="TextBox.search-box:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SecondaryActionHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRingBrush}"/>
    </Style>

    <Style Selector="TextBox.search-box:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SecondaryActionHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushFocused}"/>
    </Style>

    <Style Selector="Border.notification">
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
        <Setter Property="Width" Value="380"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRaisedBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
    </Style>

    <Style Selector="Border.notification.success">
        <Setter Property="BorderBrush" Value="{DynamicResource NotificationSuccessBrush}"/>
    </Style>

    <Style Selector="Border.notification.warning">
        <Setter Property="BorderBrush" Value="{DynamicResource NotificationWarningBrush}"/>
    </Style>

    <Style Selector="Border.notification.error">
        <Setter Property="BorderBrush" Value="{DynamicResource NotificationErrorBrush}"/>
    </Style>

    <Style Selector="Border.notification:not(.closing)">
        <Style.Animations>
            <Animation Duration="0:0:0.2" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="16"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Border.notification.closing">
        <Style.Animations>
            <Animation Duration="0:0:0.3" Easing="CubicEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="-32"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="PathIcon.notification-icon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="PathIcon.notification-icon.success">
        <Setter Property="Foreground" Value="{DynamicResource NotificationSuccessBrush}"/>
    </Style>

    <Style Selector="PathIcon.notification-icon.warning">
        <Setter Property="Foreground" Value="{DynamicResource NotificationWarningBrush}"/>
    </Style>

    <Style Selector="PathIcon.notification-icon.error">
        <Setter Property="Foreground" Value="{DynamicResource NotificationErrorBrush}"/>
    </Style>

    <Style Selector="Button.notification-close">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.notification-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="Button.notification-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}"/>
    </Style>

    <Style Selector="Button.notification-close PathIcon">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
    </Style>

    <Style Selector="Border.progress-overlay">
        <Setter Property="Background" Value="#8C000000"/>
    </Style>

    <Style Selector="Border.progress-card">
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
        <Setter Property="Padding" Value="24,20"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRaisedBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemePopupBrush}"/>
        <Setter Property="Width" Value="420"/>
        <Setter Property="Height" Value="176"/>
        <Setter Property="BoxShadow" Value="0 2 4 0 #66000000, 0 0 28 0 #99000000"/>
    </Style>

    <Style Selector="ProgressBar.themed">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="MinHeight" Value="6"/>
    </Style>

    <Style Selector="ProgressBar.thin">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="MinHeight" Value="3"/>
        <Setter Property="Height" Value="3"/>
    </Style>

    <Style Selector="TextBlock.setting-label">
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.setting-desc.checkbox-desc">
        <Setter Property="Margin" Value="28,-6,0,0"/>
    </Style>

    <Style Selector="StackPanel.setting-item">
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style Selector="TextBlock.setting-label:disabled, TextBlock.setting-desc:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="RowBackground" Value="Transparent"/>
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource ThemeHeaderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBox.asset-list">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ListBox.asset-list ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ListBoxItem TextBlock.asset-name">
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style Selector="ListBox.asset-list.grid TextBlock.asset-name">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="ListBox.asset-list.grid ListBoxItem">
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeHeaderBrush}"/>
        <Setter Property="Margin" Value="3"/>
    </Style>

    <Style Selector="ListBox.asset-list.grid Border.asset-preview-highlight">
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
    </Style>

    <Style Selector="ListBox.asset-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
    </Style>

    <Style Selector="ListBox.asset-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AssetSelectionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AssetSelectionBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource ThemeSecondaryBrush}"/>
    </Style>

    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource AssetSelectionBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Margin" Value="2,1"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource SecondaryActionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    </Style>

    <Style Selector="CheckBox:disabled /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource SecondaryActionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBrush}"/>
    </Style>

    <Style Selector="CheckBox:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource SecondaryActionHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRingBrush}"/>
    </Style>

    <Style Selector="CheckBox:pressed /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource SecondaryActionPressedBrush}"/>
    </Style>

    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle,
                     CheckBox:indeterminate /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle,
                     CheckBox:indeterminate:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle,
                     CheckBox:indeterminate:pressed /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
    </Style>

    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph,
                     CheckBox:indeterminate /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke" Value="#FFFBEB"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeJoin" Value="Round"/>
    </Style>

    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
        <Setter Property="Data" Value="M0,4 L3.5,7.5 L10,0.5"/>
    </Style>

    <Style Selector="CheckBox:indeterminate /template/ Path#CheckGlyph">
        <Setter Property="Data" Value="M0,0 L8,0"/>
    </Style>

    <Style Selector="Border.preview-toolbar CheckBox:checked /template/ Border#NormalRectangle, Border.preview-toolbar CheckBox:checked:pointerover /template/ Border#NormalRectangle, Border.preview-toolbar CheckBox:checked:pressed /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource AssetSelectionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AssetSelectionBorderBrush}"/>
    </Style>

    <Style Selector="CheckBox:focus-visible /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="CheckBox:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRaisedInputBrush}"/>
        <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="Button.filter-select-btn">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRaisedInputBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.filter-select-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryActionHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRingBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="Button.filter-select-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryActionPressedBrush}"/>
    </Style>

    <Style Selector="FlyoutPresenter.asset-filter-presenter">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.asset-filter-flyout">
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemePopupBrush}"/>
    </Style>

    <Style Selector="CheckBox.asset-filter-option">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="CheckBox.asset-filter-option /template/ Border#PART_Border">
        <Setter Property="Margin" Value="-4,0"/>
    </Style>

    <Style Selector="CheckBox.asset-filter-option:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="ComboBox /template/ Popup#PART_Popup">
        <Setter Property="Width" Value="{Binding $parent[ComboBox].Bounds.Width}"/>
    </Style>

    <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource ThemePopupBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRaisedInputBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="ComboBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
        <Setter Property="TextBlock.Foreground" Value="#FFFBEB"/>
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AssetSelectionBrush}"/>
        <Setter Property="TextBlock.Foreground" Value="#FFFBEB"/>
    </Style>

    <Style Selector="search|SearchPanel">
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRaisedBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
    </Style>

    <Style Selector="search|SearchPanel TextBox">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="search|SearchPanel TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRingBrush}"/>
    </Style>

    <Style Selector="search|SearchPanel TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushFocused}"/>
    </Style>

    <Style Selector="search|SearchPanel Button">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRaisedInputBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SecondaryActionBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="search|SearchPanel Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryActionHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRingBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="search|SearchPanel Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryActionPressedBrush}"/>
    </Style>

    <Style Selector="search|SearchPanel ToggleButton">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <Style Selector="search|SearchPanel ToggleButton:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="search|SearchPanel ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}"/>
    </Style>

    <Style Selector="search|SearchPanel ToggleButton:checked">
        <Setter Property="Foreground" Value="#FFFBEB"/>
    </Style>

    <Style Selector="search|SearchPanel ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Slider.menu-slider">
        <Setter Property="Width" Value="90"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</Styles>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Window">
        <Setter Property="Background" Value="#18181B"/>
        <Setter Property="Foreground" Value="#E4E4EA"/>
        <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#2A2A2F"/>
        <Setter Property="Background" Value="#1F1F23"/>
    </Style>

    <Style Selector="Border.status-bar">
        <Setter Property="Padding" Value="12,7"/>
    </Style>

    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Background" Value="#2A2A30"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.pill > TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#B4B4BC"/>
    </Style>

    <Style Selector="Border.preview-toolbar">
        <Setter Property="Background" Value="#1B1B1F"/>
        <Setter Property="BorderBrush" Value="#2A2A2F"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style Selector="Border.preview-toolbar.bottom">
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <Style Selector="Border.preview-overlay">
        <Setter Property="Background" Value="#CC1B1B1F"/>
        <Setter Property="BorderBrush" Value="#2A2A2F"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#F2F2F6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.status-text">
        <Setter Property="Foreground" Value="#8A8A92"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.preview-stats">
        <Setter Property="Foreground" Value="#8A8A92"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.preview-stats.error">
        <Setter Property="Foreground" Value="#E07070"/>
    </Style>

    <Style Selector="StackPanel.preview-field">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="StackPanel.preview-field > TextBlock">
        <Setter Property="Foreground" Value="#8A8A92"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.sidebar-title">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#F2F2F6"/>
    </Style>

    <Style Selector="TextBlock.sidebar-desc">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#75757D"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="TextBlock.sidebar-section">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Margin" Value="10,10,0,4"/>
    </Style>

    <Style Selector="Separator.sidebar-sep">
        <Setter Property="Margin" Value="4,6"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="#2A2A2F"/>
    </Style>

    <Style Selector="Button.sidebar-btn, Button.accent-btn">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.sidebar-btn PathIcon, Button.accent-btn PathIcon">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
    </Style>

    <Style Selector="Button.sidebar-btn TextBlock, Button.accent-btn TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.sidebar-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#C8C8D0"/>
    </Style>

    <Style Selector="Button.sidebar-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#26262B"/>
        <Setter Property="Foreground" Value="#F2F2F6"/>
    </Style>

    <Style Selector="Button.sidebar-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2C2C32"/>
    </Style>

    <Style Selector="Button.accent-btn">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.accent-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Button.accent-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Button.secondary-btn, Button.icon-btn">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#333338"/>
        <Setter Property="Background" Value="#26262B"/>
        <Setter Property="Foreground" Value="#C8C8D0"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.secondary-btn">
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="MinWidth" Value="90"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.icon-btn">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.secondary-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2C2C32"/>
        <Setter Property="BorderBrush" Value="#3C3C42"/>
        <Setter Property="Foreground" Value="#F2F2F6"/>
    </Style>

    <Style Selector="Button.secondary-btn:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.icon-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#323238"/>
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="TextBox.search-box">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Background" Value="#1B1B1F"/>
        <Setter Property="BorderBrush" Value="#2A2A2F"/>
        <Setter Property="Foreground" Value="#E4E4EA"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox.search-box:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#1B1B1F"/>
        <Setter Property="BorderBrush" Value="#3C3C42"/>
    </Style>

    <Style Selector="TextBox.search-box:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#1B1B1F"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.progress-overlay">
        <Setter Property="Background" Value="#C0141417"/>
    </Style>

    <Style Selector="Border.progress-card">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="24,20"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#333338"/>
        <Setter Property="Background" Value="#1F1F23"/>
        <Setter Property="MinWidth" Value="360"/>
        <Setter Property="MaxWidth" Value="460"/>
    </Style>

    <Style Selector="ProgressBar.themed">
        <Setter Property="Background" Value="#2A2A30"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="MinHeight" Value="6"/>
    </Style>

    <Style Selector="ProgressBar.thin">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="MinHeight" Value="3"/>
        <Setter Property="Height" Value="3"/>
    </Style>

    <Style Selector="TextBlock.setting-category">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>

    <Style Selector="TextBlock.setting-label">
        <Setter Property="Foreground" Value="#D0D0D6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.setting-desc">
        <Setter Property="Foreground" Value="#75757D"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#DADAE0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#26262B"/>
        <Setter Property="VerticalGridLinesBrush" Value="#26262B"/>
        <Setter Property="RowBackground" Value="Transparent"/>
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="#1B1B1F"/>
        <Setter Property="Foreground" Value="#8A8A92"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="#2A2A2F"/>
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="DataGridRow:pointerover">
        <Setter Property="Background" Value="#24242A"/>
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Margin" Value="2,1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="28"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="#1B1B1F"/>
        <Setter Property="BorderBrush" Value="#333338"/>
    </Style>

</Styles>

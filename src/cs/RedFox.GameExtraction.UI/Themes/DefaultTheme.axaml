<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
    </Style>

    <Style Selector="Border.asset-list-panel">
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.status-bar">
        <Setter Property="Padding" Value="12,7"/>
    </Style>

    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.pill > TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
    </Style>

    <Style Selector="Border.preview-toolbar">
        <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style Selector="Border.preview-toolbar.bottom">
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <Style Selector="Border.preview-overlay">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style Selector="TextBlock.title, TextBlock.sidebar-title">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.status-text, TextBlock.asset-info, TextBlock.preview-stats, StackPanel.preview-field > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.asset-name">
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.asset-info">
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="Border.asset-icon">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.asset-icon PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
    </Style>

    <Style Selector="TextBlock.preview-stats.error">
        <Setter Property="Foreground" Value="{DynamicResource ThemeDestructiveBrush}"/>
    </Style>

    <Style Selector="StackPanel.preview-field">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.sidebar-desc, TextBlock.setting-desc">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="TextBlock.sidebar-section, TextBlock.setting-category">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
        <Setter Property="Margin" Value="10,10,0,4"/>
    </Style>

    <Style Selector="TextBlock.setting-category">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>

    <Style Selector="Separator.sidebar-sep">
        <Setter Property="Margin" Value="4,6"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}"/>
    </Style>

    <Style Selector="Button.sidebar-btn, Button.accent-btn">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.sidebar-btn PathIcon, Button.accent-btn PathIcon">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
    </Style>

    <Style Selector="Button.sidebar-btn.secondary-action-btn PathIcon, Button.icon-btn PathIcon, Border.asset-icon PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="PathIcon.destructive-icon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeDestructiveBrush}"/>
    </Style>

    <Style Selector="Button.sidebar-btn TextBlock, Button.accent-btn TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.sidebar-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
    </Style>

    <Style Selector="Button.sidebar-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="Button.sidebar-btn.secondary-action-btn">
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="Button.sidebar-btn.secondary-action-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
    </Style>

    <Style Selector="Button.sidebar-btn.secondary-action-btn:disabled">
        <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <Style Selector="Button.sidebar-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}"/>
    </Style>

    <Style Selector="Button.accent-btn">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="#FFFBEB"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.accent-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="#FFFBEB"/>
    </Style>

    <Style Selector="Button.accent-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
        <Setter Property="Foreground" Value="#FFFBEB"/>
    </Style>

    <Style Selector="Button.secondary-btn, Button.icon-btn">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SecondaryActionBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.secondary-btn">
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="90"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.icon-btn">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.secondary-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryActionHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRingBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="Button.secondary-btn:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.icon-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}"/>
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="TextBox.search-box">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox.search-box:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRingBrush}"/>
    </Style>

    <Style Selector="TextBox.search-box:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.progress-overlay">
        <Setter Property="Background" Value="#CC0C0A09"/>
    </Style>

    <Style Selector="Border.progress-card">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="24,20"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
        <Setter Property="MinWidth" Value="360"/>
        <Setter Property="MaxWidth" Value="460"/>
    </Style>

    <Style Selector="ProgressBar.themed">
        <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinHeight" Value="6"/>
    </Style>

    <Style Selector="ProgressBar.thin">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="MinHeight" Value="3"/>
        <Setter Property="Height" Value="3"/>
    </Style>

    <Style Selector="TextBlock.setting-label">
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="RowBackground" Value="Transparent"/>
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBox.asset-list">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ListBox.asset-list ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ListBox.asset-list ListBoxItem:pointerover, DataGridRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
    </Style>

    <Style Selector="ListBox.asset-list ListBoxItem:selected, DataGridRow:selected">
        <Setter Property="Background" Value="{DynamicResource AssetSelectionBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Margin" Value="2,1"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRingBrush}"/>
    </Style>

    <Style Selector="CheckBox:pressed /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}"/>
    </Style>

    <Style Selector="CheckBox:focus-visible /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle,
                     CheckBox:indeterminate /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle,
                     CheckBox:indeterminate:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle,
                     CheckBox:indeterminate:pressed /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
    </Style>

    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph,
                     CheckBox:indeterminate /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="#FFFBEB"/>
    </Style>

    <Style Selector="CheckBox:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBrush}"/>
    </Style>

    <Style Selector="ComboBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeRingBrush}"/>
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
        <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="ComboBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
        <Setter Property="TextBlock.Foreground" Value="#FFFBEB"/>
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="TextBlock.Foreground" Value="#FFFBEB"/>
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="#66737373"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="ScrollBar:pointerover /template/ Thumb">
        <Setter Property="Background" Value="#99A1A1A1"/>
    </Style>

</Styles>

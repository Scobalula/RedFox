<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:RedFox.GameExtraction.UI"
        x:Class="RedFox.GameExtraction.UI.Views.AboutWindow"
        Title="About"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Border Classes="panel" Margin="12" Padding="24,20">
        <StackPanel Spacing="14">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
                <Image x:Name="AppIcon" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock x:Name="AppTitle" Classes="title" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock x:Name="AppVersion" Classes="status-text" HorizontalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="AppDescription"
                       Classes="status-text"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="340"
                       HorizontalAlignment="Center"/>

            <StackPanel x:Name="LinksSection" Spacing="4">
                <Separator Classes="sidebar-sep"/>
                <ItemsControl x:Name="LinksPanel">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:AboutLink">
                            <Button Classes="sidebar-btn" Click="OnLinkClick" Tag="{Binding Url}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconExternalLink}"/>
                                    <TextBlock Text="{Binding Label}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Button Classes="secondary-btn" Content="Close" HorizontalAlignment="Center" Click="OnCloseClick"/>
        </StackPanel>
    </Border>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:RedFox.GameExtraction.UI.Controls"
        xmlns:views="using:RedFox.GameExtraction.UI.Views"
        xmlns:vm="using:RedFox.GameExtraction.UI.ViewModels"
        x:Class="RedFox.GameExtraction.UI.Views.PreviewWindow"
        x:DataType="vm:PreviewViewModel"
        Title="{Binding WindowTitle}"
        Width="960" Height="640"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top"
                Classes="panel"
                Padding="16,12"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="16">
                <TextBlock Classes="title"
                           Text="{Binding AssetNameDisplay}"
                           TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1"
                        Classes="pill"
                        IsVisible="{Binding HasAsset}">
                    <TextBlock Text="{Binding AssetTypeDisplay}"/>
                </Border>
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="14">
                    <TextBlock Classes="status-text" Text="{Binding SourceNameDisplay}"/>
                    <TextBlock Classes="status-text" Text="{Binding SizeDisplay}"/>
                    <TextBlock Classes="status-text" Text="{Binding HandlerDisplay, StringFormat='Handler: {0}'}"/>
                    <TextBlock Classes="status-text" Text="{Binding PayloadTypeDisplay, StringFormat='Payload: {0}'}"/>
                    <TextBlock Classes="status-text" Text="{Binding ReferenceCount, StringFormat='References: {0:N0}'}"/>
                    <TextBlock Classes="status-text" Text="{Binding SelectionDisplay}"/>
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Classes="status-text"
                           HorizontalAlignment="Right"
                           Text="{Binding StatusText}"/>
            </Grid>
        </Border>

        <Border Classes="panel" Padding="0" ClipToBounds="True">
            <Panel>
                <ContentControl Content="{Binding Content}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="vm:ScenePreviewViewModel">
                            <views:ScenePreviewView/>
                        </DataTemplate>
                        <DataTemplate DataType="vm:AudioPreviewViewModel">
                            <views:AudioPreviewView/>
                        </DataTemplate>
                        <DataTemplate DataType="vm:TablePreviewViewModel">
                            <views:TablePreviewView/>
                        </DataTemplate>
                        <DataTemplate DataType="vm:HexPreviewViewModel">
                            <controls:HexBytesPreviewControl Bytes="{Binding Bytes}"/>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>

                <StackPanel Spacing="6"
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowPlaceholder}">
                    <TextBlock Classes="title"
                               HorizontalAlignment="Center"
                               Text="{Binding PlaceholderTitle}"/>
                    <TextBlock Classes="status-text"
                               MaxWidth="480"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               IsVisible="{Binding HasError}"
                               Text="{Binding ErrorMessage}"/>
                </StackPanel>

                <ProgressBar Classes="thin"
                             VerticalAlignment="Top"
                             IsIndeterminate="True"
                             IsHitTestVisible="False"
                             IsVisible="{Binding IsLoading}"/>
            </Panel>
        </Border>
    </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RedFox.GameExtraction.UI.ViewModels"
        x:Class="RedFox.GameExtraction.UI.Views.PreviewWindow"
        x:DataType="vm:PreviewViewModel"
        Title="{Binding WindowTitle}"
        Width="960" Height="640"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top"
                Classes="panel"
                Padding="16,12"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Classes="title"
                           Text="{Binding AssetNameDisplay}"
                           TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1"
                        Classes="pill"
                        IsVisible="{Binding HasAsset}">
                    <TextBlock Text="{Binding AssetTypeDisplay}"/>
                </Border>
            </Grid>
        </Border>

        <Border Classes="panel" Padding="0" ClipToBounds="True">
            <Panel>
                <ContentControl Content="{Binding Content}"/>

                <StackPanel Spacing="6"
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowPlaceholder}">
                    <TextBlock Classes="title"
                               HorizontalAlignment="Center"
                               Text="{Binding PlaceholderTitle}"/>
                    <TextBlock Classes="status-text"
                               MaxWidth="480"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               IsVisible="{Binding HasError}"
                               Text="{Binding ErrorMessage}"/>
                </StackPanel>

                <ProgressBar Classes="thin"
                             VerticalAlignment="Top"
                             IsIndeterminate="True"
                             IsHitTestVisible="False"
                             IsVisible="{Binding IsLoading}"/>
            </Panel>
        </Border>
    </DockPanel>
</Window>

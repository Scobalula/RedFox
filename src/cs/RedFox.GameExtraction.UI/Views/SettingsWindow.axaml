<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RedFox.GameExtraction.UI.ViewModels"
        x:Class="RedFox.GameExtraction.UI.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="Settings"
        Width="850" Height="600"
        MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="8">
        <Border DockPanel.Dock="Bottom"
                Classes="panel"
                Padding="12,10"
                Margin="0,8,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary-btn" Content="Cancel" Command="{Binding CancelCommand}"/>
                    <Button Classes="accent-btn" Content="Save" Command="{Binding SaveCommand}" HorizontalAlignment="Left" HorizontalContentAlignment="Center" Padding="14,7" MinWidth="90"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary-btn" Content="Open Log Folder" Command="{Binding OpenLogCommand}"/>
                    <Button Classes="secondary-btn" Content="Clear Logs" Command="{Binding ClearLogsCommand}"/>
                    <Button Classes="secondary-btn" Content="Clear Thumbnail Cache" Command="{Binding ClearThumbnailCacheCommand}"/>
                    <Button Classes="secondary-btn" Content="Plugins" Command="{Binding OpenPluginsCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Classes="panel"
                Padding="12,10"
                Margin="0,0,0,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <TextBox Classes="search-box" Width="200" Text="{Binding NewProfileName}" Watermark="New profile name"/>
                    <Button Classes="secondary-btn" Content="Add Profile" Command="{Binding AddProfileCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="setting-label" Text="Profile" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Width="200"/>
                    <Button Classes="secondary-btn" Content="Delete" Command="{Binding DeleteProfileCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Left"
                Classes="panel"
                Width="220"
                Padding="0"
                Margin="0,0,8,0"
                ClipToBounds="True">
            <ListBox Classes="asset-list"
                     ItemsSource="{Binding Groups}"
                     SelectedItem="{Binding SelectedGroup}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingGroupViewModel">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="10,5,14,5">
                            <Border Classes="asset-icon">
                                <PathIcon Data="{Binding Kind, Converter={StaticResource IconResourceConverter}}" Width="16" Height="16"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Classes="asset-name" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Classes="asset-info" Text="{Binding Description}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Classes="panel" Padding="0" ClipToBounds="True">
            <ContentControl Content="{Binding SelectedGroup}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:SettingGroupViewModel">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Classes="preview-toolbar">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MinHeight="34">
                                    <Border Classes="asset-icon">
                                        <PathIcon Data="{Binding Kind, Converter={StaticResource IconResourceConverter}}" Width="16" Height="16"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Classes="asset-name" Text="{Binding Title}"/>
                                        <TextBlock Classes="asset-info" Text="{Binding Description}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Sections}" Margin="16,4,16,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SettingSectionViewModel">
                                            <StackPanel>
                                                <StackPanel IsVisible="{Binding HasTitle}">
                                                    <TextBlock Classes="setting-category" Text="{Binding Title}" Margin="0,14,0,4"/>
                                                    <Separator Classes="sidebar-sep"/>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Settings}" Margin="0,10,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:GameExtractionSettingViewModel">
                                                            <StackPanel Classes="setting-item" IsEnabled="{Binding Parent.BooleanValue, FallbackValue=True}" Spacing="4">
                                                                <TextBlock Classes="setting-label" Text="{Binding Label}" IsVisible="{Binding ShowLabel}"/>
                                                                <TextBox Classes="search-box" Text="{Binding TextValue}" IsVisible="{Binding IsText}"/>
                                                                <ItemsControl ItemsSource="{Binding OptionToggles}" IsVisible="{Binding IsOptionList}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel ItemWidth="130"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:SettingOptionViewModel">
                                                                            <CheckBox IsChecked="{Binding IsSelected}">
                                                                                <TextBlock Text="{Binding Name}"/>
                                                                            </CheckBox>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <StackPanel IsVisible="{Binding IsTextList}" Spacing="8">
                                                                    <Border BorderThickness="1" BorderBrush="{DynamicResource ThemeInputBrush}" Background="{DynamicResource ThemeCardBrush}" ClipToBounds="True">
                                                                        <ListBox Classes="asset-list" Height="140" ItemsSource="{Binding TextEntries}" SelectedItem="{Binding SelectedTextEntry}" SelectionChanged="OnTextEntrySelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                                            <ListBox.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:SettingTextEntryViewModel">
                                                                                    <Panel MinHeight="28">
                                                                                        <TextBlock Text="{Binding Value}" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding !$parent[ListBoxItem].IsSelected}"/>
                                                                                        <TextBox Text="{Binding Value}" Background="Transparent" BorderThickness="0" Padding="10,0" MinHeight="28" VerticalContentAlignment="Center" IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                                                                                    </Panel>
                                                                                </DataTemplate>
                                                                            </ListBox.ItemTemplate>
                                                                        </ListBox>
                                                                    </Border>
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Button Classes="secondary-btn" Content="Add" Command="{Binding AddTextEntryCommand}"/>
                                                                        <Button Classes="secondary-btn" Content="Remove" Command="{Binding RemoveTextEntryCommand}"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <DockPanel IsVisible="{Binding IsPathSetting}">
                                                                    <Button DockPanel.Dock="Right" Classes="secondary-btn" Content="Browse" Margin="8,0,0,0" Command="{Binding BrowseCommand}"/>
                                                                    <TextBox Classes="search-box" Text="{Binding TextValue}"/>
                                                                </DockPanel>
                                                                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" IsVisible="{Binding IsChoice}" HorizontalAlignment="Left" Width="200"/>
                                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding BooleanValue}" IsVisible="{Binding IsBoolean}"/>
                                                                <DockPanel IsVisible="{Binding IsSlider}" HorizontalAlignment="Left" Width="300">
                                                                    <TextBlock DockPanel.Dock="Right" Width="56" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding SliderValue, StringFormat={}{0:0.00}}"/>
                                                                    <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding SliderValue}"/>
                                                                </DockPanel>
                                                                <TextBox Classes="search-box" Text="{Binding NumberText}" IsVisible="{Binding IsNumber}"/>
                                                                <TextBlock Classes="setting-desc" Classes.checkbox-desc="{Binding IsBoolean}" Text="{Binding Description}" IsVisible="{Binding HasDescription}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
    </DockPanel>
</Window>

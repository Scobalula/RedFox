<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RedFox.GameExtraction.UI.Views.ConfirmWindow"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Border Classes="panel" Margin="12" Padding="24,20">
        <StackPanel Spacing="18">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="secondary-btn" Content="Cancel" Click="OnCancelClick"/>
                <Button x:Name="AlternateButton" Classes="secondary-btn" Click="OnAlternateClick"/>
                <Button x:Name="ConfirmButton" Classes="accent-btn" Click="OnConfirmClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

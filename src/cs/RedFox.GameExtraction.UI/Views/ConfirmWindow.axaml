<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:RedFox.GameExtraction.UI.Controls"
        x:Class="RedFox.GameExtraction.UI.Views.ConfirmWindow"
        Classes="custom-chrome"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <controls:WindowTitleBar DockPanel.Dock="Top"/>

        <Border Classes="panel" Margin="12,0,12,12" Padding="24,20">
            <StackPanel Spacing="18">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="secondary-btn" Content="Cancel" Click="OnCancelClick"/>
                    <Button x:Name="AlternateButton" Classes="secondary-btn" Click="OnAlternateClick"/>
                    <Button x:Name="ConfirmButton" Classes="accent-btn" Click="OnConfirmClick" HorizontalContentAlignment="Center" Padding="14,7" MinWidth="90"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>

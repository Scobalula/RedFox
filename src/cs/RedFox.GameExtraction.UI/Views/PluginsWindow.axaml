<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RedFox.GameExtraction.UI.ViewModels"
        x:Class="RedFox.GameExtraction.UI.Views.PluginsWindow"
        x:DataType="vm:PluginsWindowViewModel"
        Title="Plugins"
        Width="640" Height="460"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Bottom"
                Classes="settings-action-bar"
                Margin="0,10,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Button Grid.Column="0"
                        Classes="cancel-btn"
                        Content="Open Folder"
                        Command="{Binding BrowseFolderCommand}"/>
                <Button Grid.Column="1"
                        Classes="cancel-btn"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Margin="8,0,0,0"/>
                <Button Grid.Column="3"
                        Classes="accent-btn"
                        Content="Close"
                        Command="{Binding CloseCommand}"
                        Width="90"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                Classes="search-container"
                Margin="0,0,0,10">
            <TextBox Classes="search-box"
                     Watermark="Search plugins..."
                     Text="{Binding SearchText, Mode=TwoWay}"/>
        </Border>

        <Border Classes="sidebar" Padding="0" ClipToBounds="True">
            <Grid>
                <ListBox x:CompileBindings="False"
                     ItemsSource="{Binding Plugins}"
                     Background="Transparent"
                     Foreground="#DADAE0"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="Margin" Value="2,1"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PluginRowViewModel">
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="6,8">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#E4E4EA"/>
                                <TextBlock Text="{Binding FilePath}"
                                           FontSize="11"
                                           Foreground="#78787E"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ErrorMessage}"
                                           FontSize="11"
                                           Foreground="#E07070"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      Content="Loaded"
                                      Foreground="#D0D0D6"
                                      FontSize="13"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsLoaded, Mode=TwoWay}"/>
                            <CheckBox Grid.Column="2"
                                      Content="Auto"
                                      Foreground="#D0D0D6"
                                      FontSize="13"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsAutoLoad, Mode=TwoWay}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Margin="24"
                            IsHitTestVisible="False"
                            IsVisible="{Binding IsEmpty}">
                    <TextBlock Text="No plugins found"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="#E4E4EA"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Drop plugin files into the directory below and click Refresh."
                               FontSize="12"
                               Foreground="#78787E"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding PluginsDirectory}"
                               FontSize="11"
                               Foreground="#606066"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="500"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>

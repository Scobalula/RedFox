<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="using:RedFox.GameExtraction.UI.Models"
        xmlns:vm="using:RedFox.GameExtraction.UI.ViewModels"
        x:Class="RedFox.GameExtraction.UI.Views.SourceManagerWindow"
        Title="Manage Sources"
        Width="600" Height="400"
        MinWidth="420" MinHeight="280"
        WindowStartupLocation="CenterOwner">

    <Panel>
        <DockPanel Margin="12">
            <Border Classes="panel" Padding="0" ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Classes="preview-toolbar">
                        <TextBlock Classes="title" Text="Loaded Sources"/>
                    </Border>

                    <ListBox x:Name="SourceList"
                             Classes="asset-list"
                             ClipToBounds="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.AllowAutoHide="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="model:AssetSourceViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="10,5,14,5" ColumnSpacing="12">
                                    <Border Classes="asset-icon">
                                        <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Classes="asset-name" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Classes="asset-info" Text="{Binding Location}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="asset-info" Text="{Binding AssetCount, StringFormat='{}{0:N0} assets'}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="pill" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Kind}"/>
                                    </Border>
                                    <Button Grid.Column="3"
                                            Classes="secondary-btn"
                                            Content="Unload"
                                            VerticalAlignment="Center"
                                            Click="OnUnloadClick"
                                            Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </DockPanel>

        <Border x:Name="ProgressOverlay" Classes="progress-overlay">
            <Border x:Name="ProgressCard"
                    Classes="progress-card"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    x:DataType="vm:ProgressDialogViewModel">
                <StackPanel Spacing="12">
                    <TextBlock Classes="title"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>
                    <ProgressBar Classes="themed"
                                 Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding IsIndeterminate}"
                                 Maximum="100"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Classes="status-text"
                                   Margin="16,0,0,0"
                                   Width="76"
                                   TextAlignment="Right"
                                   Text="{Binding ProgressText}"/>
                        <TextBlock Classes="status-text"
                                   Text="{Binding StatusText}"
                                   Height="18"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <Button Classes="secondary-btn"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding !IsCancelling}"
                            Width="96"
                            HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>

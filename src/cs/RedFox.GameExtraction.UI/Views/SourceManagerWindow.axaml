<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="using:RedFox.GameExtraction.UI.Models"
        x:Class="RedFox.GameExtraction.UI.Views.SourceManagerWindow"
        Title="Manage Sources"
        Width="600" Height="400"
        MinWidth="420" MinHeight="280"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">
        <Border Classes="panel" Padding="0" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" Classes="preview-toolbar">
                    <TextBlock Classes="title" Text="Loaded Sources"/>
                </Border>

                <ListBox x:Name="SourceList"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="model:AssetSourceViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="8,6" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" Foreground="#E4E4EA"/>
                                    <TextBlock Text="{Binding Location}" Classes="status-text" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Kind}" Classes="status-text"/>
                                        <TextBlock Text="{Binding AssetCount, StringFormat='{}{0:N0} assets'}" Classes="status-text"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="secondary-btn"
                                        Content="Unload"
                                        VerticalAlignment="Center"
                                        Click="OnUnloadClick"
                                        Tag="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>

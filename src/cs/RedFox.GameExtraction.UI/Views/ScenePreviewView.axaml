<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g3d="using:RedFox.Graphics3D.Avalonia"
             xmlns:vm="using:RedFox.GameExtraction.UI.ViewModels"
             x:Class="RedFox.GameExtraction.UI.Views.ScenePreviewView"
             x:DataType="vm:ScenePreviewViewModel"
             MinHeight="240">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="preview-toolbar">
            <WrapPanel ItemSpacing="12" LineSpacing="6" VerticalAlignment="Center">
                <StackPanel Classes="preview-field" IsVisible="{Binding HasMultipleScenes}">
                    <TextBlock Text="Scene"/>
                    <ComboBox Width="150" ItemsSource="{Binding SceneNames}" SelectedIndex="{Binding SelectedSceneIndex}"/>
                </StackPanel>
                <StackPanel Classes="preview-field" IsVisible="{Binding HasMultipleAnimations}">
                    <TextBlock Text="Animation"/>
                    <ComboBox Width="170" ItemsSource="{Binding AnimationNames}" SelectedIndex="{Binding SelectedAnimationIndex}"/>
                </StackPanel>
                <CheckBox Content="Pause" IsChecked="{Binding Settings.IsAnimationPaused}"/>
                <CheckBox Content="Grid" IsChecked="{Binding Settings.ShowGrid}"/>
                <CheckBox Content="Bones" IsChecked="{Binding Settings.ShowBones}"/>
                <Button Content="Fit scene" Click="OnFitClick"/>
            </WrapPanel>
        </Border>

        <Panel>
            <g3d:AvaloniaOpenGlRendererControl x:Name="Renderer"
                                               ClearColor="{DynamicResource ScenePreviewClearColor}"
                                               Scene="{Binding ActiveScene}"
                                               ViewportController="{Binding ViewportController}"
                                               UseViewBasedLighting="{Binding Settings.UseViewBasedLighting}"
                                               IsAnimationPaused="{Binding Settings.IsAnimationPaused}"
                                               SkinningMode="{Binding Settings.SkinningMode}"/>
            <Border Classes="preview-overlay"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
                <TextBlock x:Name="FpsText" Classes="preview-stats" Text="FPS: -"/>
            </Border>
            <Border Classes="preview-overlay"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom">
                <TextBlock Classes="preview-stats" Text="{Binding StatsDisplay}"/>
            </Border>
        </Panel>
    </DockPanel>
</UserControl>

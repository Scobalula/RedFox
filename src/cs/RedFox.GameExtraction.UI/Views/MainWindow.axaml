<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="using:RedFox.GameExtraction.UI.Models"
        xmlns:vm="using:RedFox.GameExtraction.UI.ViewModels"
        x:Class="RedFox.GameExtraction.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Config.WindowTitle}"
        Width="1280" Height="780"
        MinWidth="900" MinHeight="550"
        WindowStartupLocation="CenterScreen">

    <Panel>
        <DockPanel Margin="8" IsEnabled="{Binding !IsLoading}">
            <Border DockPanel.Dock="Bottom"
                    Classes="panel status-bar"
                    Margin="0,8,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Classes="status-text"
                               Margin="16,0,0,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:N0} of {1:N0} assets">
                                <Binding Path="FilteredCount"/>
                                <Binding Path="TotalCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Classes="status-text"
                               Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Left"
                    Classes="panel"
                    Width="248"
                    Margin="0,0,8,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="2">
                        <Separator Classes="sidebar-sep"/>
                        <Button Classes="sidebar-btn" Command="{Binding OpenSettingsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource IconSettings}"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="sidebar-btn" Command="{Binding OpenAboutCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource IconInfo}"/>
                                <TextBlock Text="About"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="6,4,6,14">
                                <Image x:Name="SidebarIconImage"
                                       Width="32" Height="32"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasSidebarIcon}"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="sidebar-title" Text="{Binding SidebarTitle}"/>
                                    <TextBlock Classes="sidebar-desc" Text="{Binding SidebarDescription}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Classes="sidebar-section" Text="Sources"/>
                            <Button Classes="accent-btn" Command="{Binding BrowseProcessCommand}" IsVisible="{Binding CanLoadProcess}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconGamepad}"/>
                                    <TextBlock Text="Load Process"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="accent-btn" Command="{Binding LoadSourceCommand}" IsVisible="{Binding CanLoadFiles}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconFile}"/>
                                    <TextBlock Text="Load Files"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="sidebar-btn" Command="{Binding LoadDirectoryCommand}" IsVisible="{Binding CanLoadDirectories}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconFolder}"/>
                                    <TextBlock Text="Load Folder"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="sidebar-btn" Command="{Binding ManageSourcesCommand}" IsVisible="{Binding CanLoadAnySource}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconList}"/>
                                    <TextBlock Text="{Binding SourceCountDisplay}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="sidebar-btn" Command="{Binding ClearAllCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconTrash}"/>
                                    <TextBlock Text="Clear All"/>
                                </StackPanel>
                            </Button>

                            <Separator Classes="sidebar-sep"/>

                            <TextBlock Classes="sidebar-section" Text="Assets"/>
                            <Button Classes="sidebar-btn" Command="{Binding PreviewSelectedCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconEye}"/>
                                    <TextBlock Text="Preview Selected"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="accent-btn" Command="{Binding ExportAllCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconExport}"/>
                                    <TextBlock Text="Export All"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="sidebar-btn" Command="{Binding ExportSelectedCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconExport}"/>
                                    <TextBlock Text="Export Selected"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right"
                            Classes="secondary-btn"
                            Margin="8,0,0,0"
                            Command="{Binding ToggleViewModeCommand}"
                            IsVisible="{Binding IsDirectoryViewEnabled}"
                            Content="{Binding ViewModeToggleLabel}"/>
                    <TextBox Classes="search-box"
                             PlaceholderText="Search assets"
                             Text="{Binding SearchText}"/>
                </DockPanel>

                <Border Classes="panel" Padding="0" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Classes="preview-toolbar"
                                IsVisible="{Binding IsDirectoryViewActive}">
                            <DockPanel>
                                <Button DockPanel.Dock="Left"
                                        Classes="icon-btn"
                                        Margin="0,0,10,0"
                                        Command="{Binding NavigateUpCommand}"
                                        IsEnabled="{Binding CanNavigateUp}">
                                    <PathIcon Data="{StaticResource IconArrowUp}" Width="12" Height="12"/>
                                </Button>
                                <TextBlock Classes="status-text"
                                           Text="{Binding CurrentDirectoryPath}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>

                        <Panel>
                            <DataGrid x:Name="AssetDataGrid"
                                      IsVisible="{Binding !IsDirectoryViewActive}"
                                      ItemsSource="{Binding AssetsView}"
                                      SelectedItem="{Binding SelectedAsset}"
                                      AutoGenerateColumns="False"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      RowHeight="30"
                                      SelectionChanged="OnAssetSelectionChanged"
                                      DoubleTapped="OnAssetDoubleTapped">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name, DataType=model:AssetRowViewModel}" Width="2*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type, DataType=model:AssetRowViewModel}" Width="140"/>
                                    <DataGridTextColumn Header="Information" Binding="{Binding Information, DataType=model:AssetRowViewModel}" Width="3*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DataGrid x:Name="ExplorerDataGrid"
                                      IsVisible="{Binding IsDirectoryViewActive}"
                                      ItemsSource="{Binding ExplorerView}"
                                      AutoGenerateColumns="False"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="False"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      RowHeight="30"
                                      SelectionChanged="OnExplorerSelectionChanged"
                                      DoubleTapped="OnExplorerDoubleTapped">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="36" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="model:AssetExplorerEntry">
                                                <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" IsVisible="{Binding IsFolder}"/>
                                                    <PathIcon Data="{StaticResource IconFile}" Width="14" Height="14" IsVisible="{Binding IsFile}"/>
                                                </Panel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name, DataType=model:AssetExplorerEntry}" Width="2*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay, DataType=model:AssetExplorerEntry}" Width="140"/>
                                    <DataGridTextColumn Header="Information" Binding="{Binding Information, DataType=model:AssetExplorerEntry}" Width="3*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Panel>
                    </DockPanel>
                </Border>
            </DockPanel>
        </DockPanel>

        <Border Classes="progress-overlay" IsVisible="{Binding ShowProgressDialog}">
            <Border Classes="progress-card"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DataContext="{Binding ProgressDialog}">
                <StackPanel Spacing="12">
                    <TextBlock Classes="title" Text="{Binding Title}"/>
                    <ProgressBar Classes="themed"
                                 Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding IsIndeterminate}"
                                 Maximum="100"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Classes="status-text"
                                   Margin="16,0,0,0"
                                   Text="{Binding ProgressText}"/>
                        <TextBlock Classes="status-text"
                                   Text="{Binding StatusText}"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <Button Classes="secondary-btn"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding !IsCancelling}"
                            HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="using:RedFox.GameExtraction.UI.Models"
        xmlns:vm="using:RedFox.GameExtraction.UI.ViewModels"
        x:Class="RedFox.GameExtraction.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Config.WindowTitle}"
        Width="1280" Height="780"
        MinWidth="900" MinHeight="550"
        WindowStartupLocation="CenterScreen">

    <Panel>
        <DockPanel Margin="8">
            <Border DockPanel.Dock="Bottom"
                    Classes="panel status-bar"
                    Margin="0,8,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Classes="status-text"
                               Margin="16,0,0,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:N0} of {1:N0} assets">
                                <Binding Path="FilteredCount"/>
                                <Binding Path="TotalCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Classes="status-text"
                               Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Left"
                    Classes="panel"
                    Width="248"
                    Margin="0,0,8,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="2">
                        <Separator Classes="sidebar-sep"/>
                        <Button Classes="sidebar-btn" Command="{Binding OpenDonateCommand}" IsVisible="{Binding CanDonate}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Classes="heart-icon" Data="{StaticResource IconHeart}"/>
                                <TextBlock Text="Donate"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="sidebar-btn" Command="{Binding OpenSettingsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource IconSettings}"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="sidebar-btn" Command="{Binding OpenAboutCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource IconInfo}"/>
                                <TextBlock Text="About"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="6,4,6,14">
                                <Image x:Name="SidebarIconImage"
                                       Width="32" Height="32"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasSidebarIcon}"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="sidebar-title" Text="{Binding SidebarTitle}"/>
                                    <TextBlock Classes="sidebar-desc" Text="{Binding SidebarDescription}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Classes="sidebar-section" Text="Sources"/>
                            <Button Classes="accent-btn" Command="{Binding BrowseProcessCommand}" IsVisible="{Binding CanLoadProcess}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconGamepad}"/>
                                    <TextBlock Text="Load Process"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="accent-btn" Command="{Binding LoadSourceCommand}" IsVisible="{Binding CanLoadFiles}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconFile}"/>
                                    <TextBlock Text="Load Files"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="sidebar-btn secondary-action-btn" Command="{Binding LoadDirectoryCommand}" IsVisible="{Binding CanLoadDirectories}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconFolder}"/>
                                    <TextBlock Text="Load Folder"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="sidebar-btn secondary-action-btn" Command="{Binding ManageSourcesCommand}" IsVisible="{Binding CanLoadAnySource}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconList}"/>
                                    <TextBlock Text="{Binding SourceCountDisplay}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="sidebar-btn secondary-action-btn" Command="{Binding ClearAllCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Classes="destructive-icon" Data="{StaticResource IconTrash}"/>
                                    <TextBlock Text="Clear All"/>
                                </StackPanel>
                            </Button>

                            <Separator Classes="sidebar-sep"/>

                            <TextBlock Classes="sidebar-section" Text="Assets"/>
                            <Button Classes="sidebar-btn secondary-action-btn" Command="{Binding PreviewSelectedCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconEye}"/>
                                    <TextBlock Text="Preview Selected"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="accent-btn" Command="{Binding ExportAllCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconExport}"/>
                                    <TextBlock Text="Export All"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="sidebar-btn secondary-action-btn" Command="{Binding ExportSelectedCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource IconExport}"/>
                                    <TextBlock Text="Export Selected"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBox Classes="search-box"
                             PlaceholderText="Search assets"
                             Text="{Binding SearchText}"/>
                </DockPanel>

                <Border Classes="panel asset-list-panel" Padding="0" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Classes="preview-toolbar">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Classes="status-text"
                                           Text="{Binding SelectedAssetsSummary}"
                                           IsVisible="{Binding HasSelectedAssets}"
                                           VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Left"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBlock Classes="status-text" Text="Type" VerticalAlignment="Center"/>
                                    <Button Classes="filter-select-btn"
                                            Width="200"
                                            ToolTip.Tip="{Binding AssetTypeFilterSummary}">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom" FlyoutPresenterClasses="asset-filter-presenter">
                                                <Border Classes="asset-filter-flyout" Width="200" MaxHeight="360">
                                                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                                        <StackPanel Spacing="6">
                                                            <CheckBox Content="All types" IsChecked="{Binding IsAllAssetTypesSelected, Mode=TwoWay}"/>
                                                            <Separator/>
                                                            <ItemsControl ItemsSource="{Binding AssetTypeFilterOptions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:AssetFilterOptionViewModel">
                                                                        <CheckBox Classes="asset-filter-option" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       ToolTip.Tip="{Binding Name}"/>
                                                                        </CheckBox>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding AssetTypeFilterSummary}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <PathIcon Grid.Column="1"
                                                      Data="{StaticResource IconChevronDown}"
                                                      Width="10"
                                                      Height="10"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <TextBlock Classes="status-text" Text="Source" VerticalAlignment="Center"/>
                                    <Button Classes="filter-select-btn"
                                            Width="300"
                                            ToolTip.Tip="{Binding AssetSourceFilterSummary}">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom" FlyoutPresenterClasses="asset-filter-presenter">
                                                <Border Classes="asset-filter-flyout" Width="300" MaxHeight="360">
                                                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                                        <StackPanel Spacing="6">
                                                            <CheckBox Content="All sources" IsChecked="{Binding IsAllAssetSourcesSelected, Mode=TwoWay}"/>
                                                            <Separator/>
                                                            <ItemsControl ItemsSource="{Binding AssetSourceFilterOptions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:AssetFilterOptionViewModel">
                                                                        <CheckBox Classes="asset-filter-option" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       ToolTip.Tip="{Binding Name}"/>
                                                                        </CheckBox>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding AssetSourceFilterSummary}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <PathIcon Grid.Column="1"
                                                      Data="{StaticResource IconChevronDown}"
                                                      Width="10"
                                                      Height="10"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <TextBlock Classes="status-text" Text="Sort" VerticalAlignment="Center"/>
                                    <ComboBox Width="112"
                                              ItemsSource="{Binding SortOptions}"
                                              SelectedItem="{Binding SortBy, Mode=TwoWay}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Panel>
                            <ListBox x:Name="AssetListBox"
                                     Classes="asset-list"
                                     ClipToBounds="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.AllowAutoHide="False"
                                     ItemsSource="{Binding AssetsView}"
                                     SelectionMode="Multiple"
                                     SelectionChanged="OnAssetSelectionChanged"
                                     DoubleTapped="OnAssetDoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="model:AssetRowViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="12"
                                              Margin="10,5,14,5">
                                            <Border Classes="asset-icon">
                                                <PathIcon Data="{Binding Category, Converter={StaticResource IconResourceConverter}}" Width="16" Height="16"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Classes="asset-name"
                                                           Text="{Binding Name}"
                                                           ToolTip.Tip="{Binding Name}"
                                                           TextTrimming="LeadingCharacterEllipsis"/>
                                                <TextBlock Classes="asset-info"
                                                           Text="{Binding Information}"
                                                           IsVisible="{Binding HasInformation}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Classes="pill">
                                                <TextBlock Text="{Binding Type}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Spacing="6"
                                        Margin="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        IsVisible="{Binding IsAssetListEmpty}">
                                <TextBlock Classes="title"
                                           HorizontalAlignment="Center"
                                           Text="No assets loaded"/>
                                <TextBlock Classes="status-text"
                                           TextAlignment="Center"
                                           Text="Load a source to browse its assets."/>
                            </StackPanel>

                            <StackPanel Spacing="6"
                                        Margin="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        IsVisible="{Binding NoMatchingAssets}">
                                <TextBlock Classes="title"
                                           HorizontalAlignment="Center"
                                           Text="No matching assets"/>
                                <TextBlock Classes="status-text"
                                           TextAlignment="Center"
                                           Text="Try a different search term."/>
                            </StackPanel>

                        </Panel>
                    </DockPanel>
                </Border>
            </DockPanel>
        </DockPanel>

        <Border Classes="progress-overlay" IsVisible="{Binding ShowProgressDialog}">
            <Border Classes="progress-card"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DataContext="{Binding ProgressDialog}">
                <StackPanel Spacing="12">
                    <TextBlock Classes="title"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>
                    <ProgressBar Classes="themed"
                                 Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding IsIndeterminate}"
                                 Maximum="100"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Classes="status-text"
                                   Margin="16,0,0,0"
                                   Width="76"
                                   TextAlignment="Right"
                                   Text="{Binding ProgressText}"/>
                        <TextBlock Classes="status-text"
                                   Text="{Binding StatusText}"
                                   Height="18"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <Grid Height="32" ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0"
                                Classes="secondary-btn"
                                Content="Open Export Folder"
                                Command="{Binding OpenExportFolderCommand}"
                                IsVisible="{Binding IsCompleted}"
                                HorizontalAlignment="Left"/>
                        <Button Grid.Column="1"
                                Classes="secondary-btn"
                                Content="Cancel"
                                Command="{Binding CancelCommand}"
                                IsVisible="{Binding !IsCompleted}"
                                IsEnabled="{Binding !IsCancelling}"
                                Width="96"
                                HorizontalAlignment="Right"/>
                        <Button Grid.Column="1"
                                Classes="secondary-btn"
                                Content="Close"
                                Command="{Binding CloseCommand}"
                                IsVisible="{Binding IsCompleted}"
                                Width="96"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>

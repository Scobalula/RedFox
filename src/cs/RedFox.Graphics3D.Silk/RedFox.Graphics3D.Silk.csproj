<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>RedFox.Graphics3D.Silk</PackageId>
    <PackageDescription>Silk.NET windowing integration for RedFox Graphics3D renderers.</PackageDescription>
    <PackageVersion Condition="'$(RedFoxGraphics3DSilkPackageVersion)' != ''">$(RedFoxGraphics3DSilkPackageVersion)</PackageVersion>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.0.0-local</PackageVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedFox.Graphics3D.Rendering\RedFox.Graphics3D.Rendering.csproj" />
    <ProjectReference Include="..\RedFox.IO\RedFox.IO.csproj" />
  </ItemGroup>

</Project>

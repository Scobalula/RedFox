<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageDescription>LZ4 block and frame compression codecs for RedFox Compression.</PackageDescription>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedFox.Compression\RedFox.Compression.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="runtimes\win-x64\native\liblz4.dll" Link="liblz4.dll" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes\win-x64\native\liblz4.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\licenses\LZ4-LICENSE" Pack="true" PackagePath="licenses" Visible="false" />
  </ItemGroup>

</Project>

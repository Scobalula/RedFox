<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageDescription>FLAC audio codec for RedFox Audio, backed by native libFLAC.</PackageDescription>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RedFox.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedFox.Audio\RedFox.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="runtimes\win-x64\native\libFLAC.dll" Link="libFLAC.dll" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes\win-x64\native\libFLAC.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\licenses\FLAC-LICENSE" Pack="true" PackagePath="licenses" Visible="false" />
  </ItemGroup>

</Project>

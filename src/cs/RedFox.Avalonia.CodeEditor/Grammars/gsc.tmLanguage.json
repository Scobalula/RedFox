{
  "scopeName": "source.gsc",
  "name": "GSC",
  "fileTypes": [ "gsc", "csc", "gsh" ],
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#function-declaration" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#calls" },
    { "include": "#variables" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.gsc", "match": "//.*$" },
        { "name": "comment.block.gsc", "begin": "/\\*", "end": "\\*/" },
        { "name": "punctuation.section.dev.gsc", "match": "/#|#/" }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "match": "^\\s*(#(?:using_animtree|using|insert|namespace|define|precache|if|elif|else|endif))\\b\\s*(.*?)\\s*;?\\s*(?://.*)?$",
          "captures": {
            "1": { "name": "keyword.control.directive.gsc" },
            "2": { "name": "string.unquoted.path.gsc" }
          }
        }
      ]
    },
    "function-declaration": {
      "begin": "^\\s*(function)\\s+(?:(private|autoexec)\\s+)?(?:(autoexec|private)\\s+)?([A-Za-z_]\\w*)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "storage.type.function.gsc" },
        "2": { "name": "storage.modifier.gsc" },
        "3": { "name": "storage.modifier.gsc" },
        "4": { "name": "entity.name.function.gsc" }
      },
      "end": "\\)",
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "name": "variable.parameter.gsc", "match": "[A-Za-z_]\\w*" },
        { "include": "#operators" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.gsc",
          "begin": "[&#]?\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.gsc", "match": "\\\\." }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.gsc", "match": "\\b(?:if|else|for|foreach|in|while|do|switch|case|default|break|continue|return|wait|waittill|waittillmatch|waittillframeend|notify|endon)\\b" },
        { "name": "storage.type.gsc", "match": "\\b(?:function|class|var|const|thread|childthread|constructor|destructor|extends)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.gsc", "match": "\\b(?:true|false|undefined)\\b" },
        { "name": "variable.language.gsc", "match": "\\b(?:self|level|game|world|anim|vararg)\\b" },
        { "name": "variable.other.constant.gsc", "match": "\\b[A-Z][A-Z0-9_]*\\b(?!\\s*\\()" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.gsc", "match": "\\b(?:0[xX][0-9a-fA-F]+|\\d+\\.?\\d*(?:[eE][+-]?\\d+)?|\\.\\d+)\\b" }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "([A-Za-z_]\\w*)(::)([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "entity.name.type.namespace.gsc" },
            "2": { "name": "punctuation.separator.namespace.gsc" },
            "3": { "name": "entity.name.function.gsc" }
          }
        },
        {
          "match": "(::)([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "punctuation.separator.namespace.gsc" },
            "2": { "name": "entity.name.function.gsc" }
          }
        },
        { "name": "entity.name.function.gsc", "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()" }
      ]
    },
    "variables": {
      "patterns": [
        { "name": "variable.other.gsc", "match": "\\b[A-Za-z_]\\w*\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.gsc", "match": "!==|===|!=|==|<=|>=|&&|\\|\\||\\+\\+|--|\\+=|-=|\\*=|/=|[-+*/%=!<>&|^~?:]" }
      ]
    }
  }
}

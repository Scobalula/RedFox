<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageDescription>Raw Deflate, zlib, and gzip compression codecs for RedFox Compression, backed by upstream zlib.</PackageDescription>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedFox.Compression\RedFox.Compression.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="runtimes\win-x64\native\zlib1.dll" Link="zlib1.dll" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes\win-x64\native\zlib1.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\licenses\ZLib-LICENSE" Pack="true" PackagePath="licenses" Visible="false" />
  </ItemGroup>

</Project>

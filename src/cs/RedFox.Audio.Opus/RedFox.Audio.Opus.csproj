<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageDescription>Opus audio encoder and decoder for RedFox Audio.</PackageDescription>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedFox.Audio\RedFox.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\licenses\Opus-LICENSE" Pack="true" PackagePath="licenses" Visible="false" />
    <None Update="Native\opus.dll" Pack="true" PackagePath="runtimeFiles">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

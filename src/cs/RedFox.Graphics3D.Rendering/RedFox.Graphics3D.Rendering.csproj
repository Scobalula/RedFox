<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>RedFox.Graphics3D.Rendering</PackageId>
    <PackageDescription>Renderer-neutral contracts and infrastructure for RedFox Graphics3D.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RedFox.Graphics3D\RedFox.Graphics3D.csproj" />
    <ProjectReference Include="..\\RedFox.Imaging\\RedFox.Imaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Materials\Definitions\*.materialtype.json" Link="MaterialTypes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimeFiles/MaterialTypes/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>RedFox.Graphics3D.Rendering</PackageId>
    <PackageDescription>Renderer-neutral contracts and infrastructure for RedFox Graphics3D.</PackageDescription>
    <PackageVersion Condition="'$(RedFoxGraphics3DRenderingPackageVersion)' != ''">$(RedFoxGraphics3DRenderingPackageVersion)</PackageVersion>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.0.0-local</PackageVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RedFox.Graphics3D\RedFox.Graphics3D.csproj" />
    <ProjectReference Include="..\RedFox.Graphics2D\RedFox.Graphics2D.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Materials\Definitions\*.materialtype.json" Link="MaterialTypes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

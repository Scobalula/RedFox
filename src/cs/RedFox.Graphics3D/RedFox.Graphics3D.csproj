<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>RedFox.Graphics3D</PackageId>
    <PackageDescription>Scene, mesh, material, animation, and translation abstractions for RedFox Graphics3D.</PackageDescription>
    <PackageVersion Condition="'$(RedFoxGraphics3DCorePackageVersion)' != ''">$(RedFoxGraphics3DCorePackageVersion)</PackageVersion>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.0.0-local</PackageVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedFox.Graphics2D\RedFox.Graphics2D.csproj" />
    <ProjectReference Include="..\RedFox.Graphics2D.Primitives\RedFox.Graphics2D.Primitives.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageDescription>Zstandard compression codec for RedFox Compression, backed by native libzstd.</PackageDescription>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedFox.Compression\RedFox.Compression.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="runtimes\win-x64\native\libzstd.dll" Link="libzstd.dll" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes\win-x64\native\libzstd.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\licenses\ZStd-LICENSE" Pack="true" PackagePath="licenses" Visible="false" />
  </ItemGroup>

</Project>

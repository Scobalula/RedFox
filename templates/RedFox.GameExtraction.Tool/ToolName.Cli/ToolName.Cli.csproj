<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RedFox.GameExtraction.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToolName\ToolName.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\assets\Icon.png" Link="Icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
